{
  "name": "my-comon",
  "displayName": "My Common Serial Monitor",
  "description": "串口监视器 - 支持实时日志过滤和搜索功能 (Serial Monitor with log filtering and search)",
  "version": "1.0.19",
  "publisher": "my-publisher",
  "icon": "ico.png",
  "author": "My Developer",
  "license": "EPL-2.0",
  "main": "dist/desktop/extension.js",
  "browser": "dist/browser/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack -w",
    "package": "vsce package --no-yarn"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.85.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@vscode/vsce": "^3.2.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "myComonPanel",
          "title": "My Comon",
          "icon": "ico.png"
        }
      ]
    },
    "views": {
      "myComonPanel": [
        {
          "id": "myComon.serialView",
          "name": "My Serial Monitor",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Serial Monitor",
      "properties": {
        "serial-monitor.defaultBaud": {
          "type": "string",
          "default": "115200",
          "description": "默认波特率"
        },
        "serial-monitor.maxLogLines": {
          "type": "number",
          "default": 10000,
          "description": "最大日志行数"
        },
        "serial-monitor.showTimestamp": {
          "type": "boolean",
          "default": true,
          "description": "显示时间戳"
        }
      }
    }
  },
  "activationEvents": [
    "onView:myComon.serialView"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tuy0326/my_comon.git"
  },
  "extensionKind": [
    "ui"
  ]
}
